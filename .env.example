# 由维护者配置；此文件仅作模板，不要填写真实密钥后分发。
# 复制为 .env 后填入你的密钥。程序只读取 .env，不读取本文件。

# API Key（必填）
# 获取地址：https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxx

# 模型 ID（必填）
MODEL_ID=claude-sonnet-4-6

# Base URL（可选，Anthropic-compatible 网关）
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# =============================================================================
#  Anthropic-compatible 供应商速查（按需取消注释）
#
#  供应商            MODEL_ID                  说明               Base URL
#  ----------------  -------------------------  ----------------  ---------------------
#  Anthropic         claude-sonnet-4-6          default           (默认)
#  MiniMax           MiniMax-M3                 M 系列最新        see below
#  GLM (智谱)        glm-5.2                    最新 coding 模型  see below
#  Kimi (月之暗面)   kimi-k2.7-code             coding 模型       see below
#  DeepSeek          deepseek-v4-pro             pro 模型          see below
#                    deepseek-v4-flash           flash 模型        see below
#
#  请以各供应商官网为准确认最新可用性、价格与区域。
# =============================================================================

# ---- 国际版 ----

# MiniMax          https://www.minimax.io
# ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
# MODEL_ID=MiniMax-M3
# MODEL_ID=MiniMax-M2.7
# MODEL_ID=MiniMax-M2.7-highspeed

# GLM (智谱)       https://z.ai
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# MODEL_ID=glm-5.2

# Kimi (月之暗面)  https://platform.kimi.ai
# ANTHROPIC_BASE_URL=https://api.moonshot.ai/anthropic
# MODEL_ID=kimi-k2.7-code
# MODEL_ID=kimi-k2.7-code-highspeed
# MODEL_ID=kimi-k2.6

# DeepSeek         https://platform.deepseek.com
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# MODEL_ID=deepseek-v4-pro
# MODEL_ID=deepseek-v4-flash

# ---- 中国大陆 ----

# MiniMax          https://platform.minimax.io
# ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
# MODEL_ID=MiniMax-M3
# MODEL_ID=MiniMax-M2.7
# MODEL_ID=MiniMax-M2.7-highspeed

# GLM (智谱)       https://open.bigmodel.cn
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# MODEL_ID=glm-5.2

# Kimi (月之暗面)  https://platform.moonshot.cn
# ANTHROPIC_BASE_URL=https://api.moonshot.cn/anthropic
# MODEL_ID=kimi-k2.7-code
# MODEL_ID=kimi-k2.7-code-highspeed
# MODEL_ID=kimi-k2.6

# DeepSeek（全球同一入口，无区域区分）
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# MODEL_ID=deepseek-v4-pro
# MODEL_ID=deepseek-v4-flash
